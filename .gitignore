# --- environment & credentials (never commit) ---
.env
.env.*
!.env.example
auth.json
Homestead.json
Homestead.yaml
*.pem
*.key

# --- catatan & dokumentasi internal ---
*.md
/docs/

# --- dependencies & build output ---
/node_modules
/vendor
/public/build
/public/hot
/public/storage
/bootstrap/ssr

# --- runtime data ---
/storage/*.key
/storage/pail
/storage/logs/*
!/storage/logs/.gitignore

# --- tooling ---
.DS_Store
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.playwright-mcp
npm-debug.log
yarn-error.log
